<article class="mkt-venue-card">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img class="mkt-venue-thumb-image" src="@ImageUrl" alt="@Name" />
    }
    else
    {
        <div class="mkt-venue-thumb"></div>
    }
    <h4>@Name</h4>
    <p>@City</p>
    <span>@Tag</span>
</article>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string City { get; set; } = string.Empty;
    [Parameter] public string Tag { get; set; } = string.Empty;
    [Parameter] public string? ImageUrl { get; set; }
}
