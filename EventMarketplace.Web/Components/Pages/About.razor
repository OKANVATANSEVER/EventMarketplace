@page "/about"
@layout MainLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>Hakkımızda - EventPazar</PageTitle>

<section class="mkt-section">
    <h1>@(_page?.Title ?? "Hakkımızda")</h1>
    <p class="mkt-muted">@(_page?.Body ?? "Icerik yukleniyor...")</p>
</section>

@code {
    private SitePageContentModel? _page;

    protected override async Task OnInitializedAsync()
    {
        _page = await Api.GetSitePageAsync("about");
    }
}
