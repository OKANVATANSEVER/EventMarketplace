@page "/home"
@page "/"
@layout MainLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>EventPazar - Bugün ne yapmak istersin?</PageTitle>

<section class="mkt-hero">
    <div class="mkt-hero-grid">
        <div>
            <p class="mkt-kicker">Etkinlik Pazaryeri</p>
            <h1>Bugün ne yapmak istersin?</h1>
            <p>Konser, tiyatro, workshop ve aile etkinliklerini tek bir akışta keşfet.</p>
            <SearchBar />
        </div>
        <div class="mkt-hero-side">
            <p>Canlı şehir trafiği</p>
            <h3>@_liveCounter aktif ilan</h3>
            <small>Son 24 saatte @_newCount yeni etkinlik</small>
        </div>
    </div>
</section>

<section class="mkt-section">
    
    <FeaturedCarousel Events="_featured" />
</section>
@if( _todayCategories.Length > 0)
{
<section class="mkt-section">
    <div class="mkt-section-header">
        <h2>Bugün Etkinlikler</h2>
    </div>
    <div class="mkt-chip-row">
        @foreach (var category in _todayCategories)
        {
            <a href="/events?title=@category" class="mkt-chip">@category</a>
        }
    </div>
</section>
}
@if(_tonight.Count > 0)
{
<section class="mkt-section">
    <div class="mkt-section-header">
        <h2>En Yakın Hangi Etkinlikler ?</h2>
    </div>
    <div class="mkt-card-grid">
        @foreach (var ev in _tonight)
        {
            <EventCard Event="ev" />
        }
    </div>
</section>
}
 @if (_popularVenues.Count > 0)
        {
            <section class="mkt-section">
                <div class="mkt-section-header">
                    <h2>Popüler Mekanlar</h2>
                </div>
                <div class="mkt-venues-grid">
                    @if (_popularVenues.Count > 0)
                    {
                        @foreach (var venue in _popularVenues)
                        {
                            <VenueCard Name="@venue.Name" City="@venue.City" Tag="@venue.Tag" ImageUrl="@venue.ImageUrl" />
                        }
                    }
                    
                </div>
            </section>
}

<section class="mkt-section">
    <BannerAd
        Title="@(_heroBanner?.Title ?? "Reklam Alanı")"
    Subtitle="@(_heroBanner?.Subtitle ?? "728x90 Banner")"
    LinkUrl="@_heroBanner?.LinkUrl"
    ImageUrl="@_heroBanner?.ImageUrl"
    Height="140px" />
</section>

@if (_latest.Count > 0)
{
    <section class="mkt-section">
        <div class="mkt-section-header">
           <h2>Son Eklenen Etkinlik İlanları</h2>
        </div>
        <div class="mkt-card-grid">
            @foreach (var ev in _latest)
            {
                <EventCard Event="ev" />
            }
        </div>
    </section>
}

@code {
    private List<PublicFeaturedEventModel> _featured = [];
    private List<EventListItemModel> _tonight = [];
    private List<EventListItemModel> _latest = [];
    private List<PopularVenueModel> _popularVenues = [];
    private readonly string[] _todayCategories = ["Konserler", "Tiyatro", "Workshop", "Çocuk"];
    //private readonly string[] _todayCategories = [];
    private int _liveCounter;
    private int _newCount;
    private AdvertisementSlotModel? _heroBanner;

    protected override async Task OnInitializedAsync()
    {
        var featuredResult = await Api.GetPublicFeaturedAsync("home-carousel");
        var recentResult = await Api.GetEventsAsync(isApproved: true, page: 1, pageSize: 24);
        var heroAds = await Api.GetPublicAdSlotsAsync("home-hero");
        _popularVenues = await Api.GetPublicPopularVenuesAsync();

        _featured = featuredResult.OrderBy(x => x.StartDate).ToList();
        _heroBanner = heroAds.OrderBy(x => x.Priority).FirstOrDefault();

        var all = recentResult?.Items.OrderByDescending(x => x.StartDate).ToList() ?? [];
        _latest = all.Take(6).ToList();

        var now = DateTime.Now;
        _tonight = all
            .Where(x => x.StartDate.Date == now.Date)
            .OrderBy(x => x.StartDate)
            .Take(8)
            .ToList();

        if (_tonight.Count == 0)
        {
            _tonight = all.Take(8).OrderBy(x => x.StartDate).ToList();
        }

        _liveCounter = all.Count;
        _newCount = all.Count(x => x.StartDate >= now.AddDays(-1));
    }
}
