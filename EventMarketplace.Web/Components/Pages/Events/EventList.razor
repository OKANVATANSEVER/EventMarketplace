@page "/"
@page "/events"
@layout MainLayout
@rendermode InteractiveServer
@inject ApiClient Api

<PageTitle>Etkinlikler – EventMarketplace</PageTitle>

<div class="em-events-page">
    <h1 class="em-page-title">🎪 Tüm Etkinlikler</h1>

    <!-- Filters -->
    <div class="em-filters">
        <input @bind="_searchTitle" @bind:event="oninput" @bind:after="SearchAsync"
            class="em-input" placeholder="Etkinlik adı ara..." />
        <input @bind="_searchCity" @bind:event="oninput" @bind:after="SearchAsync"
            class="em-input" placeholder="Şehir ara..." />
        <select @bind="_categoryId" @bind:after="SearchAsync" class="em-select">
            <option value="">Tüm Kategoriler</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
        <select @bind="_featured" @bind:after="SearchAsync" class="em-select">
            <option value="">Tümü</option>
            <option value="true">⭐ Öne Çıkanlar</option>
        </select>
        <select @bind="_approved" @bind:after="SearchAsync" class="em-select">
            <option value="">Tüm Etkinlikler</option>
            <option value="true">Aktif</option>
            <option value="false">Pasif</option>
        </select>
        <button @onclick="ResetFilters" class="em-btn-outline">Sıfırla</button>
    </div>

    @if (_loading)
    {
        <div class="em-loading"><div class="em-spinner"></div><p>Yükleniyor...</p></div>
    }
    else if (!_result?.Items.Any() ?? true)
    {
        <div class="em-empty-state">
            <p>🔍 Bu kriterlere uygun etkinlik bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="em-events-grid">
            @foreach (var ev in _result!.Items)
            {
                <EventCard Event="ev" />
            }
        </div>

        <!-- Pagination -->
        @if (_result.TotalCount > _pageSize)
        {
            <div class="em-pagination">
                <button @onclick="PrevPage" disabled="@(_page <= 1)" class="em-btn-outline">← Önceki</button>
                <span>Sayfa @_page / @TotalPages</span>
                <button @onclick="NextPage" disabled="@(_page >= TotalPages)" class="em-btn-outline">Sonraki →</button>
            </div>
        }
    }
</div>

@code {
    private PagedResultModel<EventListItemModel>? _result;
    private List<CategoryModel> _categories = [];
    private bool _loading = true;
    private string _searchCity = string.Empty;
    private string _searchTitle = string.Empty;
    private string _featured = string.Empty;
    private string _approved = "true";
    private string _categoryId = string.Empty;
    private int _page = 1;
    private const int _pageSize = 9;
    private int TotalPages => (int)Math.Ceiling((double)(_result?.TotalCount ?? 0) / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        _categories = await Api.GetCategoriesAsync();
        await LoadAsync();
    }

    private async Task ResetFilters()
    {
        _searchCity = string.Empty;
        _searchTitle = string.Empty;
        _featured = string.Empty;
        _approved = "true";
        _categoryId = string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        bool? isFeatured = _featured == "true" ? true : null;
        bool? isApproved = _approved == "true" ? true : (_approved == "false" ? false : null);
        var city = string.IsNullOrWhiteSpace(_searchCity) ? null : _searchCity.Trim();
        var title = string.IsNullOrWhiteSpace(_searchTitle) ? null : _searchTitle.Trim();
        var categoryId = string.IsNullOrEmpty(_categoryId) ? null : (Guid?)Guid.Parse(_categoryId);

        _result = await Api.GetEventsAsync(city, categoryId, isFeatured, isApproved, title, _page, _pageSize);
        if (_result is not null)
        {
            _result = _result with { Items = _result.Items.OrderByDescending(x => x.StartDate).ToList() };
        }
        _loading = false;
    }
}
