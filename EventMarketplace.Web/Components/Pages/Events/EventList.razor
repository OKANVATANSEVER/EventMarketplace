@page "/events"
@layout MainLayout
@using EventMarketplace.Application.Repositories
@using EventMarketplace.Application.DTOs
@inject IEventRepository EventRepo

<PageTitle>Etkinlikler – EventMarketplace</PageTitle>

<div class="em-events-page">
    <h1 class="em-page-title">🎪 Tüm Etkinlikler</h1>

    <!-- Filters -->
    <div class="em-filters">
         <input @bind="_searchCity" @bind:event="oninput" @bind:after="SearchAsync"
             class="em-input" placeholder="Şehir ara..." />
        <select @bind="_featured" @bind:after="SearchAsync" class="em-select">
            <option value="">Tümü</option>
            <option value="true">⭐ Öne Çıkanlar</option>
        </select>
        <button @onclick="ResetFilters" class="em-btn-outline">Sıfırla</button>
    </div>

    @if (_loading)
    {
        <div class="em-loading"><div class="em-spinner"></div><p>Yükleniyor...</p></div>
    }
    else if (!_result?.Items.Any() ?? true)
    {
        <div class="em-empty-state">
            <p>🔍 Bu kriterlere uygun etkinlik bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="em-events-grid">
            @foreach (var ev in _result!.Items)
            {
                <EventCard Event="ev" />
            }
        </div>

        <!-- Pagination -->
        @if (_result.TotalCount > _pageSize)
        {
            <div class="em-pagination">
                <button @onclick="PrevPage" disabled="@(_page <= 1)" class="em-btn-outline">← Önceki</button>
                <span>Sayfa @_page / @TotalPages</span>
                <button @onclick="NextPage" disabled="@(_page >= TotalPages)" class="em-btn-outline">Sonraki →</button>
            </div>
        }
    }
</div>

@code {
    private PagedResult<EventListItemDto>? _result;
    private bool _loading = true;
    private string _searchCity = string.Empty;
    private string _featured = string.Empty;
    private int _page = 1;
    private const int _pageSize = 9;
    private int TotalPages => (int)Math.Ceiling((double)(_result?.TotalCount ?? 0) / _pageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void ResetFilters()
    {
        _searchCity = string.Empty;
        _featured = string.Empty;
        _page = 1;
        _ = LoadAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        bool? isFeatured = _featured == "true" ? true : null;
        var city = string.IsNullOrWhiteSpace(_searchCity) ? null : _searchCity.Trim();

        _result = await EventRepo.GetFilteredAsync(city, null, isFeatured, _page, _pageSize);
        _loading = false;
    }
}
