@page "/admin/content"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Icerik Yonetimi</PageTitle>

<h1 class="em-page-title">Icerik Yonetimi</h1>
<p class="em-page-subtitle">Icerik alanlarini ayrı sayfalardan yonetin ve yayin durumlarini takip edin.</p>

<AdminContentNav />

<section class="em-content-menu-grid">
    <a class="em-content-menu-card" href="/admin/content/pages">
        <strong>Sayfa Icerikleri</strong>
        <span>About, contact ve privacy sayfalarini duzenleyin.</span>
    </a>
    <a class="em-content-menu-card" href="/admin/content/ad-slots">
        <strong>Reklam Slotlari</strong>
        <span>Aktif-pasif durumu ve yayin suresi takibiyle banner yonetimi.</span>
    </a>
    <a class="em-content-menu-card" href="/admin/content/featured-listings">
        <strong>Sponsorlu Listing Slotu</strong>
        <span>Homepage sponsorlu etkinlikleri silmeden yonetin.</span>
    </a>
    <a class="em-content-menu-card" href="/admin/content/inbox">
        <strong>Mesaj Inbox</strong>
        <span>Etkinlik bazli gelen tum mesajlari tek ekranda izleyin.</span>
    </a>
    <a class="em-content-menu-card" href="/admin/content/venues">
        <strong>Populer Mekanlar</strong>
        <span>Anasayfada gosterilen mekan kartlarini yonetin.</span>
    </a>
</section>

<section class="mkt-section">
    <div class="mkt-placement-guide">
        <strong>Placement Kullanim Ozeti</strong>
        <span><b>home-hero</b>: Ana sayfa banner reklam karti.</span>
        <span><b>detail-sidebar</b>: Etkinlik detay sayfasi sag blok reklam karti.</span>
        <span><b>home-carousel</b>: Ana sayfa sponsorlu etkinlik carousel alani.</span>
    </div>
</section>
