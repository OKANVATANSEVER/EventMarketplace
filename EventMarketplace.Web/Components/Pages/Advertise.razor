@page "/advertise"
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>Reklam Ver - EventPazar</PageTitle>

<section class="mkt-section">
    <h1>Reklam Ver</h1>
    <p class="mkt-muted">Markanı etkinlik kitlesiyle buluşturacak paketleri seç.</p>

    <div class="mkt-package-grid">
        <article class="mkt-package">
            <h3>Bronze</h3>
            <ul>
                <li>Liste üstü görünürlük</li>
                <li>7 gün yayın</li>
            </ul>
            <strong>2.900 TL</strong>
        </article>

        <article class="mkt-package featured">
            <h3>Silver</h3>
            <ul>
                <li>Ana sayfa öne çıkan</li>
                <li>15 gün yayın</li>
            </ul>
            <strong>5.900 TL</strong>
        </article>

        <article class="mkt-package">
            <h3>Gold</h3>
            <ul>
                <li>Ana sayfa + banner</li>
                <li>30 gün yayın</li>
            </ul>
            <strong>9.900 TL</strong>
        </article>
    </div>

    <button class="mkt-btn mkt-btn-primary">Online Ödeme</button>
</section>
