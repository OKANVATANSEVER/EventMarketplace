@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="em-layout">
    <NavMenu />
    <main class="em-main">
        <div class="em-content">
            @Body
        </div>
    </main>
    <footer class="mkt-footer">
        <div class="mkt-footer-inner">
            <a href="/about">Hakkımızda</a>
            <AuthorizeView>
                <Authorized Context="authCtx">
                    <AuthorizeView Roles="Organizer,Admin">
                        <a href="/advertise">Reklam Ver</a>
                    </AuthorizeView>
                </Authorized>
                <NotAuthorized>
                    <a href="/advertise">Reklam Ver</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="/contact">İletişim</a>
            <a href="/privacy">Gizlilik</a>
        </div>
    </footer>
</div>
