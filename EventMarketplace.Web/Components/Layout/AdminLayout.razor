@inherits LayoutComponentBase
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="em-admin-layout">
    <!-- Sidebar -->
    <aside class="em-sidebar">
        <div class="em-sidebar-logo">🎟 Admin Panel</div>
        <nav class="em-sidebar-nav">
            <a href="/admin/dashboard" class="@NavClass("/admin/dashboard")">
                <span>📊</span> Dashboard
            </a>
            <a href="/admin/events" class="@NavClass("/admin/events")">
                <span>🎪</span> Etkinlikler
            </a>
            <a href="/admin/members" class="@NavClass("/admin/members")">
                <span>👥</span> Üyeler
            </a>
            <div class="em-sidebar-group">
                <a href="/admin/content" class="@NavClass("/admin/content")">
                    <span>🧩</span> Icerik Yonetimi
                </a>
                <div class="em-sidebar-subnav">
                    <a href="/admin/content/pages" class="@NavClass("/admin/content/pages")">Sayfa Icerikleri</a>
                    <a href="/admin/content/ad-slots" class="@NavClass("/admin/content/ad-slots")">Reklam Slotlari</a>
                    <a href="/admin/content/featured-listings" class="@NavClass("/admin/content/featured-listings")">Sponsorlu Listing Slotu</a>
                    <a href="/admin/content/inbox" class="@NavClass("/admin/content/inbox")">Mesaj Inbox</a>
                    <a href="/admin/content/venues" class="@NavClass("/admin/content/venues")">Populer Mekanlar</a>
                </div>
            </div>
            <hr />
            <a href="/">← Siteye Dön</a>
            <button @onclick="HandleLogout" class="em-sidebar-logout">Çıkış Yap</button>
        </nav>
    </aside>
    <!-- Content -->
    <div class="em-admin-content">
        <div class="em-admin-body">
            @Body
        </div>
    </div>
</div>

@code {
    private string NavClass(string href)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        var target = href.TrimStart('/');
        return current.StartsWith(target, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }

    private async Task HandleLogout()
    {
        await AuthProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
