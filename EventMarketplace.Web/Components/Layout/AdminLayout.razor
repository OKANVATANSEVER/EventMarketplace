@inherits LayoutComponentBase
@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="em-admin-layout">
    <!-- Sidebar -->
    <aside class="em-sidebar">
        <div class="em-sidebar-logo">🎟 Admin Panel</div>
        <nav class="em-sidebar-nav">
            <a href="/admin/dashboard" class="@NavClass("/admin/dashboard")">
                <span>📊</span> Dashboard
            </a>
            <a href="/admin/events" class="@NavClass("/admin/events")">
                <span>🎪</span> Etkinlikler
            </a>
            <a href="/admin/members" class="@NavClass("/admin/members")">
                <span>👥</span> Üyeler
            </a>
            <a href="/admin/content" class="@NavClass("/admin/content")">
                <span>🧩</span> Icerik
            </a>
            <hr />
            <a href="/">← Siteye Dön</a>
            <button @onclick="HandleLogout" class="em-sidebar-logout">Çıkış Yap</button>
        </nav>
    </aside>
    <!-- Content -->
    <div class="em-admin-content">
        <div class="em-admin-body">
            @Body
        </div>
    </div>
</div>

@code {
    private string NavClass(string href)
        => Nav.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;

    private async Task HandleLogout()
    {
        await AuthProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
